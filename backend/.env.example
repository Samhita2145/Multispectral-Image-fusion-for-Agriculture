# Copy this file to .env and fill in real values. Never commit .env.

# Secret key used to sign JWT access tokens. Generate one with e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-64-character-hex-string

# How long a login session / JWT stays valid, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite database file location (default is fine for local/dev use).
# DATABASE_URL=sqlite:///./app.db

# Comma-separated list of frontend origins allowed to call this API via CORS.
# If you open the frontend HTML files directly (file://) in the browser,
# the browser sends Origin: null, which is included below by default.
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000,null

# -------------------------------------------------------------------
# Chatbot LLM API Configuration
# Supply an API key for AT LEAST ONE of the following supported providers:
# -------------------------------------------------------------------
# 1) Google Gemini (Recommended - fast & generous free tier):
# GEMINI_API_KEY=your_gemini_api_key_here
#
# 2) OpenAI:
# OPENAI_API_KEY=your_openai_api_key_here
#
# 3) Anthropic:
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
#
# 4) Groq:
# GROQ_API_KEY=your_groq_api_key_here
#
# Optional custom model override (e.g. gemini-1.5-flash, gpt-4o-mini, claude-3-5-haiku-20241022, llama-3.1-8b-instant):
# LLM_MODEL=
# Optional custom OpenAI-compatible base URL:
# OPENAI_BASE_URL=
